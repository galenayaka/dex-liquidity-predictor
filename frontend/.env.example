# WebSocket endpoint of the FastAPI backend.
# Copy to `.env.local` and adjust if the backend runs elsewhere.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# REST API base URL (used to fetch historical metrics).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Crypto price forecast service (crypto-forecast/).
NEXT_PUBLIC_FORECAST_URL=http://localhost:8100

# ---------------------------------------------------------------------------
# Deployment base path (build-time only).
#
# Leave BOTH empty when the exported site is served from the domain root. If
# the dashboard is hosted under a sub-folder (e.g. https://example.com/dashboard
# or http://localhost/dex-liquidity-predictor/public), set both to that path:
#   NEXT_PUBLIC_BASE_PATH=/dashboard
#   NEXT_PUBLIC_ASSET_PREFIX=/dashboard
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_ASSET_PREFIX=
