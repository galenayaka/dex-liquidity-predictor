# Copy this file to `.env` and adjust values.

# --- Application ---
DEBUG=false
ENVIRONMENT=development
# JSON list of allowed browser origins for CORS.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database ---
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/dex_predictor

# --- Web3 RPC ---
# Set MOCK_MODE=true to run the backend without any blockchain node.
# Synthetic data is generated so the dashboard works end-to-end offline.
MOCK_MODE=true

# HTTP provider (used for on-chain reads).
RPC_URL_HTTP=https://eth-mainnet.g.alchemy.com/v2/your-api-key
# WebSocket provider (used for mempool subscriptions).
RPC_URL_WS=wss://eth-mainnet.g.alchemy.com/v2/your-api-key
CHAIN_ID=1
REQUEST_TIMEOUT_SECONDS=15

# --- Uniswap v3 (Ethereum mainnet) ---
UNISWAP_V3_FACTORY=0x1F98431c8aD98523631AE4a59f267346ea31F984
UNISWAP_V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
UNISWAP_V3_POSITION_MANAGER=0xC36442b4a4522E871399CD717aBDD847Ab11FE88
# Pool watched by the Swap/Burn event listener (USDC/WETH 0.3%).
UNISWAP_V3_POOL_ETH_USDC=0x8ad599c3A0ff1De082011EFDDc58f1908eb6e6D8
UNISWAP_V3_POOL_PAIR=ETH/USDC

# --- Monitoring ---
SCAN_INTERVAL_SECONDS=30
# Liquidity change (fraction) that counts as a "drain" event for the heuristic.
LIQUIDITY_DRAIN_THRESHOLD=-0.15
# Price impact (fraction) above which a reference trade is flagged.
PRICE_IMPACT_ALERT_THRESHOLD=0.03
SAMPLE_HISTORY_SIZE=180
# Path of the trained XGBoost model (JSON). If missing, a heuristic is used.
MODEL_PATH=models/liquidity_drain_model.json
# Optional .pkl model used by LiquidityPredictor for the live event stream.
LIQUIDITY_MODEL_PATH=models/liquidity_predictor.pkl

# --- Market maker (simulated execution layer) ---
# When true, provide/withdraw only print logs; no real transactions are sent.
SIMULATION_MODE=true
# Uniswap v3 tick spacing (60 = 0.3% fee tier) and max range widening per side.
MARKET_MAKER_TICK_SPACING=60
MARKET_MAKER_MAX_RANGE_STEPS=10
# Token decimals used to convert human price -> Uniswap raw-price tick.
MARKET_MAKER_TOKEN0_DECIMALS=6
MARKET_MAKER_TOKEN1_DECIMALS=18
# Notional (human units) deposited when opening a position.
MARKET_MAKER_AMOUNT0=1000.0
MARKET_MAKER_AMOUNT1=0.3
# Only needed for REAL execution (SIMULATION_MODE=false). Leave empty in dev.
# WALLET_PRIVATE_KEY=
# WALLET_ADDRESS=

